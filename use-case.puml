@startuml
left to right direction
skinparam packageStyle rectangle

' Styling to make it look professional
skinparam usecase {
  BackgroundColor AliceBlue
  BorderColor DarkBlue
  ArrowColor DarkBlue
}
skinparam actorStyle awesome

actor "Demographic Analyst" as Analyst

package "DevOps Population Reporting System" {

  ' Base Use Cases
  usecase "Generate Country Reports\n(Reqs 1-3)" as UC1
  usecase "Generate City Reports\n(Reqs 7-11)" as UC2
  usecase "Generate Capital City Reports\n(Reqs 17-19)" as UC3
  usecase "View Population Demographics\n(Reqs 23-31)" as UC4
  usecase "View Language Statistics\n(Req 32)" as UC5

  ' Extended Behavior (User Input)
  usecase "Filter by Top 'N' Entries\n(Reqs 4-6, 12-16, 20-22)" as UC_Filter

  ' Relationships showing that filtering extends the base reports
  UC1 <.. UC_Filter : <<extend>>
  UC2 <.. UC_Filter : <<extend>>
  UC3 <.. UC_Filter : <<extend>>
}

' Primary Actor Interactions
Analyst --> UC1
Analyst --> UC2
Analyst --> UC3
Analyst --> UC4
Analyst --> UC5

@enduml